---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { albumSlug, getSortedAlbums } from '../../data/albums';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const albums = await getSortedAlbums();
  return albums.map((album, i) => ({
    params: { slug: albumSlug(album) },
    props: {
      album,
      chapter: i + 1,
      prev: albums[i - 1] ?? null,
      next: albums[i + 1] ?? null,
    },
  }));
}

function toRoman(n: number): string {
  const numerals: [number, string][] = [
    [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let out = '';
  for (const [value, glyph] of numerals) {
    while (n >= value) {
      out += glyph;
      n -= value;
    }
  }
  return out;
}

const { album, chapter, prev, next } = Astro.props;
const { Content } = await render(album);
// markdown body = optional release notes; skip the section when it's empty
// (HTML comments don't count — the template leaves one as a placeholder)
const hasNotes = Boolean(album.body?.replace(/<!--[\s\S]*?-->/g, '').trim());
const year = album.data.releaseDate.getUTCFullYear();
const fullDate = album.data.releaseDate.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const dev = import.meta.env.DEV;
// lineup is either a flat list of "Name | instruments" strings or a list of
// { heading, members } groups; normalize to groups so the template renders
// one shape
const lineup =
  album.data.lineup.length > 0 && typeof album.data.lineup[0] === 'string'
    ? [{ heading: undefined, members: album.data.lineup as string[] }]
    : (album.data.lineup as { heading: string; members: string[] }[]);
---

<BaseLayout
  title={`Krallice — ${album.data.title}`}
  description={`Krallice — ${album.data.title} (${year}).`}
  backdrop={album.data.backdropArt ?? album.data.coverArt}
>
  <main class="mx-auto max-w-3xl px-6 py-10 md:py-14">
    <header>
      <div class="flex flex-col items-center gap-8 md:flex-row md:gap-10">
        <div class="aspect-square w-full max-w-xs shrink-0 overflow-hidden border border-stone-800 bg-stone-950 shadow-[0_0_40px_rgba(0,0,0,0.6)] md:max-w-sm">
          {album.data.coverArt ? (
            <button type="button" data-cover-open class="block h-full w-full cursor-zoom-in">
              <img src={album.data.coverArt} alt={album.data.title} class="h-full w-full object-cover" />
            </button>
          ) : (
            <div class="flex h-full w-full items-center justify-center p-4 text-center font-display text-stone-400">
              {album.data.title}
            </div>
          )}
        </div>
        {album.data.tracks.length > 0 && (
          <div class="w-full min-w-0 flex-1">
            <ol class="divide-y divide-stone-800/70 border-y border-stone-800/70">
              {album.data.tracks.map((t, i) => (
                <li class="flex items-baseline gap-4 py-3">
                  <span class="font-mono text-xs tabular-nums text-stone-600">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline justify-between gap-4">
                      <span class="font-serif text-lg text-stone-200">{t.title}</span>
                      {(t.tab || t.lyrics) && (
                        <span class="flex shrink-0 items-baseline gap-4">
                          {/* provisional tab hook: a bare link to whatever `tab`
                              points at (file or page); final UX undecided */}
                          {t.tab && (
                            <a
                              href={t.tab}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-[0.6rem] uppercase tracking-[0.25em] text-stone-600 transition-colors hover:text-stone-200"
                            >
                              Tab
                            </a>
                          )}
                          {t.lyrics && (
                            <button
                              type="button"
                              data-lyrics-open={`lyrics-${i}`}
                              class="cursor-pointer text-[0.6rem] uppercase tracking-[0.25em] text-stone-600 transition-colors hover:text-stone-200"
                            >
                              Lyrics
                            </button>
                          )}
                        </span>
                      )}
                    </div>
                    {(t.initiated || t.written) && (
                      <p class="mt-0.5 text-[0.6rem] uppercase tracking-[0.25em] text-stone-500">
                        {t.initiated ? `initiated: ${t.initiated}` : `written: ${t.written}`}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
      <div class="mt-10 text-center">
        <h1 class="font-display text-5xl font-medium text-stone-100 md:text-6xl">
          {album.data.title}
        </h1>
        {album.data.subtitle && (
          <p class="mt-2 text-xs uppercase tracking-[0.3em] text-stone-400">
            {album.data.subtitle}
          </p>
        )}
        <p class="mt-3 font-mono text-sm uppercase tracking-[0.4em] tabular-nums text-stone-500">
          {toRoman(chapter)} ·{' '}
          <span class="group relative cursor-pointer">
            {year}
            <span class="pointer-events-none absolute top-full left-1/2 mt-2 -translate-x-1/2 whitespace-nowrap border border-stone-700 bg-stone-950 px-3 py-1.5 text-[0.8rem] normal-case tracking-[0.2em] text-stone-300 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
              {fullDate}
            </span>
          </span>
        </p>
      </div>
    </header>

    {/* players: one centered column, capped at the Ampwall player's own max
        width (650px), so both share edges regardless of their natural sizes;
        each gets a small chrome-register label */}
    {(album.data.bandcampEmbed || dev) && (
      <section class="mx-auto mt-12 max-w-[650px]">
        <p class="mb-1.5 text-[0.6rem] uppercase tracking-[0.3em] text-stone-600">Bandcamp</p>
        {album.data.bandcampEmbed ? (
          <div class="embed" data-player set:html={album.data.bandcampEmbed} />
        ) : (
          <div class="flex h-24 items-center justify-center border border-dashed border-stone-700 text-center text-xs uppercase tracking-widest text-stone-600">
            Add bandcampEmbed in frontmatter
          </div>
        )}
        {album.data.ampwallEmbed ? (
          <>
            <p class="mt-8 mb-1.5 text-[0.6rem] uppercase tracking-[0.3em] text-stone-600">Ampwall</p>
            <div class="embed embed-scaled" data-player set:html={album.data.ampwallEmbed} />
            {album.data.bandcampEmbed && (
              <>
                {/* both players can run at once — a feature. This toggle opts
                    out: clicking into one player resets the other (see script) */}
                <button
                  type="button"
                  data-solo-toggle
                  aria-pressed="false"
                  title="Starting one player will stop the other"
                  class="group mt-3 ml-auto flex cursor-pointer items-center gap-2 text-[0.6rem] uppercase tracking-[0.25em] text-stone-600 transition-colors hover:text-stone-300 aria-pressed:text-stone-400"
                >
                  <span aria-hidden="true" class="inline-block size-2 border border-current group-aria-pressed:bg-current"></span>
                  Disable simultaneous play
                </button>
              </>
            )}
          </>
        ) : album.data.ampwallUrl ? (
          <p class="mt-2 text-right">
            <a
              href={album.data.ampwallUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[0.7rem] uppercase tracking-[0.25em] text-stone-500 transition-colors hover:text-stone-200"
            >
              Also on Ampwall →
            </a>
          </p>
        ) : null}
      </section>
    )}

    {(album.data.engineering || album.data.lineup.length > 0) && (
      <section class="mt-6 border border-stone-800/70 bg-black/30 py-4 px-2 sm:mt-12">
        {/* <h2 class="mb-3 text-[0.7rem] uppercase tracking-[0.3em] text-stone-500">
          Recording &amp; Engineering
        </h2> */}
        {album.data.engineering && (
          <div class="space-y-3 font-serif text-base text-center leading-relaxed text-stone-400">
            {album.data.engineering.split(/\n\n+/).map((p) => (
              <p class="whitespace-pre-wrap">{p}</p>
            ))}
          </div>
        )}
        {lineup.length > 0 && (
          <div class="mt-4 border-t border-stone-800/70 pt-4">
            {lineup.map((group, g) => (
              <div class:list={[g > 0 && 'mt-4']}>
                {group.heading && (
                  <p class="mb-1.5 text-center text-[0.6rem] uppercase tracking-[0.3em] text-stone-500">
                    {group.heading}
                  </p>
                )}
                <p class="text-center font-serif text-base leading-relaxed whitespace-pre-wrap">
                  {group.members.map((member, i) => {
                    const [name, instruments] = member.split('|').map((s) => s.trim());
                    return (
                      <>
                        {/* two members per line: break before every even index */}
                        {i > 0 && (i % 2 === 0 ? <br /> : '   ')}
                        <span class="whitespace-nowrap">
                          <span class="text-stone-200">{name}</span>
                          <span class="text-stone-500">: {instruments}</span>
                        </span>
                      </>
                    );
                  })}
                </p>
              </div>
            ))}
          </div>
        )}
      </section>
    )}

    {hasNotes && (
      <section class="notes mt-12">
        <Content />
      </section>
    )}

    {/* after notes prose the nav needs a rule to close the section; without
        notes it follows the bordered credits panel, where a second rule
        reads as a double border — so it sits closer, unruled */}
    <nav
      class:list={[
        'grid grid-cols-1 gap-4 sm:grid-cols-2',
        hasNotes ? 'mt-20 border-t border-stone-800/70 pt-10' : 'mt-10',
      ]}
    >
      {prev ? (
        <a
          href={`/albums/${albumSlug(prev)}`}
          class="group block border border-stone-800 px-5 pt-2 pb-4 transition-colors hover:border-stone-600"
        >
          <span class="text-[0.65rem] uppercase tracking-[0.3em] text-stone-600">Previous release</span>
          <span class="mt-1 block font-display text-lg text-stone-300 group-hover:text-stone-100">
            ← {prev.data.title}
          </span>
        </a>
      ) : (
        <div class="hidden sm:block"></div>
      )}

      {next ? (
        <a
          href={`/albums/${albumSlug(next)}`}
          class="group block border border-stone-700 bg-black/30 px-5 pt-2 pb-4 text-right transition-colors hover:border-stone-400"
        >
          <span class="text-[0.65rem] uppercase tracking-[0.3em] text-stone-500">Next release</span>
          <span class="mt-1 block font-display text-xl text-stone-100">
            {next.data.title} →
          </span>
        </a>
      ) : (
        <a
          href="/discography"
          class="group block border border-stone-700 bg-black/30 px-5 pt-2 pb-4 text-right transition-colors hover:border-stone-400"
        >
          <span class="text-[0.65rem] uppercase tracking-[0.3em] text-stone-500">End of discography</span>
          <span class="mt-1 block font-display text-xl text-stone-100">
            Back to discography →
          </span>
        </a>
      )}
    </nav>

    {album.data.coverArt && (
      <dialog
        id="cover-zoom"
        class="m-auto w-fit max-w-none border border-stone-700 bg-stone-950 p-0 shadow-[0_0_60px_rgba(0,0,0,0.8)] backdrop:bg-black/70"
      >
        {/* max-only constraints: the image caps at the viewport but never
            upscales past its natural size, so low-res covers stay unpixelated */}
        <img
          src={album.data.coverArt}
          alt={album.data.title}
          class="block max-h-[85vh] max-w-[90vw] cursor-zoom-out"
        />
      </dialog>
    )}

    {album.data.tracks.map(
      (t, i) =>
        t.lyrics && (
          <dialog
            id={`lyrics-${i}`}
            class="m-auto w-full max-w-lg border border-stone-700 bg-stone-950 p-0 text-stone-200 shadow-[0_0_60px_rgba(0,0,0,0.8)] backdrop:bg-black/70"
          >
            <div class="flex items-baseline justify-between gap-6 border-b border-stone-800/70 px-6 py-4">
              <div class="min-w-0">
                <h2 class="font-display text-2xl text-stone-100">{t.title}</h2>
                {t.lyricsBy && (
                  <p class="mt-1 text-[0.6rem] uppercase tracking-[0.25em] text-stone-500">
                    lyrics: {t.lyricsBy}
                  </p>
                )}
              </div>
              <button
                type="button"
                data-lyrics-close
                class="cursor-pointer text-[0.6rem] uppercase tracking-[0.25em] text-stone-500 transition-colors hover:text-stone-200"
              >
                Close
              </button>
            </div>
            <div class="max-h-[60vh] overflow-y-auto px-6 py-5">
              <p class="whitespace-pre-line font-serif text-base leading-relaxed text-stone-300">{t.lyrics}</p>
            </div>
          </dialog>
        ),
    )}
  </main>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-lyrics-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dialog = document.getElementById(btn.dataset.lyricsOpen!);
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });
    document.querySelectorAll<HTMLDialogElement>('dialog[id^="lyrics-"]').forEach((dialog) => {
      dialog.querySelector('[data-lyrics-close]')?.addEventListener('click', () => dialog.close());
      // p-0 on the dialog means inner content covers it fully, so a click
      // whose target is the dialog itself can only be on the ::backdrop
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    });

    const coverDialog = document.getElementById('cover-zoom');
    if (coverDialog instanceof HTMLDialogElement) {
      document
        .querySelector('[data-cover-open]')
        ?.addEventListener('click', () => coverDialog.showModal());
      // any click — image or backdrop — closes the zoom
      coverDialog.addEventListener('click', () => coverDialog.close());
    }

    // "Disable simultaneous play": the two players are cross-origin iframes
    // with no pause API, but a click inside one moves document.activeElement
    // to that iframe. While the toggle is on, a poll watches for that and
    // reloads the *other* player if it may be playing (interacted with since
    // its last reset), which stops its audio.
    const solo = document.querySelector<HTMLButtonElement>('[data-solo-toggle]');
    const players = Array.from(document.querySelectorAll<HTMLIFrameElement>('[data-player] iframe'));
    if (solo && players.length === 2) {
      const KEY = 'solo-play';
      const touched = new Set<HTMLIFrameElement>();
      let active: HTMLIFrameElement | null = null;
      let timer: number | undefined;
      const reset = (f: HTMLIFrameElement) => {
        f.src = f.src;
        touched.delete(f);
      };
      const tick = () => {
        const el = document.activeElement;
        if (!(el instanceof HTMLIFrameElement) || !players.includes(el)) {
          active = null; // focus left the players; the next click in one is a new interaction
          return;
        }
        if (el === active) return;
        active = el;
        touched.add(el);
        for (const other of players) if (other !== el && touched.has(other)) reset(other);
      };
      const apply = (on: boolean) => {
        solo.setAttribute('aria-pressed', String(on));
        window.clearInterval(timer);
        if (on) {
          // anything could already be playing, so treat every player as live
          for (const f of players) touched.add(f);
          active = null;
          timer = window.setInterval(tick, 200);
        }
      };
      let on = false;
      try {
        on = localStorage.getItem(KEY) === 'on';
      } catch {}
      if (on) apply(true);
      solo.addEventListener('click', () => {
        on = !on;
        apply(on);
        try {
          localStorage.setItem(KEY, on ? 'on' : 'off');
        } catch {}
      });
    }
  </script>
</BaseLayout>
